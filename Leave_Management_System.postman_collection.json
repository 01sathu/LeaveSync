            ],
            "url": {
              "raw": "{{baseUrl}}/employee/profile",
              "host": ["{{baseUrl}}"],
              "path": ["employee", "profile"]
            }
          }
        },
        {
          "name": "Get Leave Balance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{employeeToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/employee/leave-balance",
              "host": ["{{baseUrl}}"],
              "path": ["employee", "leave-balance"]
