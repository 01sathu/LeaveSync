{
  "info": {
    "name": "Leave Management System API",
    "_postman_id": "d8291f53-274e-4b2a-9e11-85b410972bc2",
    "description": "Complete Postman collection for testing the Leave Management System API, including authentication, employee endpoints, admin workflows, validation, and idempotency edge cases.",
