            "body": {
              "mode": "raw",
              "raw": "{\n  \"rejectionReason\": \"Department requires on-site coverage during this window.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/leaves/{{leaveId}}/reject",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "leaves", "{{leaveId}}", "reject"]
